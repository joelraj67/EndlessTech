# Google Forms - Contact form submission (Option 1: Direct POST)
# 1. Create Google Form with fields: Full Name, Work Email, Inquiry Type, Project Details
# 2. Get formResponse URL: Open form → ⋮ → "Get pre-filled link" → fill dummy data → copy URL
#    Format: https://docs.google.com/forms/d/e/FORM_ID/formResponse
# 3. Get entry IDs: View page source → search "entry." → copy entry.XXXXXXXXX for each field
# 4. Replace values below:
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
NEXT_PUBLIC_GOOGLE_ENTRY_NAME=entry.XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ENTRY_EMAIL=entry.YYYYYYYYY
NEXT_PUBLIC_GOOGLE_ENTRY_SERVICE=entry.ZZZZZZZZZ
NEXT_PUBLIC_GOOGLE_ENTRY_MESSAGE=entry.AAAAAAAAA

# Web3Forms - Contact form submission (Option 2: Email relay)
# Get your access key at https://web3forms.com/
# Free tier: 250 submissions/month, unlimited forms, unlimited domains
NEXT_PUBLIC_WEB3FORMS_KEY=your_access_key_here